# Local RustFS/S3 configuration (object storage under the Iceberg warehouse)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me
AWS_DEFAULT_REGION=us-east-1

# Redpanda (Kafka-compatible broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=opencode
KAFKA_CONSUMER_GROUP=opencode-iceberg-sink
KAFKA_PORT=9092
SINK_MAX_RECORDS=2000
SINK_FLUSH_INTERVAL_SECONDS=5

# Local application and collector configuration
OPENCODE_DB=$HOME/.local/share/opencode/opencode.db
PRODUCER_STATE_FILE=data/state/producer-state.json
OPENCODE_ANALYTICS_INTERVAL=30
OPENCODE_ANALYTICS_PID_FILE=.opencode-analytics.pid
OPENCODE_ANALYTICS_LOG=opencode-analytics.log

# Spark aggregates (fallback Parquet local sans Iceberg)
SPARK_OUTPUT=data/spark
# SPARK_INPUT=data/parquet

# Docker Compose host ports
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
DASHBOARD_PORT=8501

# Apache Iceberg REST catalog
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://iceberg-warehouse
ICEBERG_BUCKET=iceberg-warehouse
ICEBERG_PORT=8181
ICEBERG_S3_ENDPOINT=http://localhost:9000
ICEBERG_S3_PATH_STYLE_ACCESS=true
